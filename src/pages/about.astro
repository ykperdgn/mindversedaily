---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="మా గురించి - About Us"
	description="తెలుగు వార్తలు సైట్ గురించి తెలుసుకోండి"
	pubDate={new Date('November 19 2025')}
	heroImage={AboutHeroImage}
>
	<p>
		తెలుగు వార్తలు సైట్ తెలుగు భాషలో తాజా మరియు అంతర్జాలం నుండి సేకరించిన వార్తలను అందిస్తుంది. మా లక్ష్యం వినియోగదారులకు విలువైన సమాచారాన్ని అందించడం మరియు అఫిలియేట్ మోనెటైజేషన్ ద్వారా సురక్షితమైన ఆదాయాన్ని సాధించడం.
	</p>

	<p>
		AdSense వంటి ప్రకటనలకు బదులుగా, మేము Media.net, PropellerAds మరియు Amazon Associates వంటి ప్లాట్‌ఫారమ్‌లను ఉపయోగిస్తాము, ఇవి వినియోగదారు అనుభవాన్ని మెరుగుపరుస్తాయి మరియు పాలసీలకు అనుగుణంగా ఉంటాయి.
	</p>
</Layout>
