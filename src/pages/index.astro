---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="te">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>తెలుగు వార్తలు - Telugu News</h1>
			<p>
				తెలుగు భాషలో తాజా వార్తలు మరియు కథనాలను అందించే వెబ్‌సైట్. ఇక్కడ మీరు వివిధ విషయాలపై అంతర్జాలం నుండి సేకరించిన వార్తలను చదవవచ్చు. రకరకాల అఫిలియేట్ లింక్‌ల ద్వారా మీకు ఉపయోగకరమైన సేవలు మరియు ఉత్పత్తులను కనుగొనండి.
			</p>
			<p>
				ఈ సైట్ AdSense వంటి ప్రకటనలకు బదులుగా Media.net, PropellerAds మరియు Amazon Associates వంటి సురక్షితమైన ప్రకటన ప్లాట్‌ఫారమ్‌లను ఉపయోగిస్తుంది, ఇది మీ అనుభవాన్ని మెరుగుపరుస్తుంది.
			</p>
			<p>వార్తలను అన్వేషించండి:</p>
			<ul>
				<li><a href="/blog">వార్తల జాబితా</a></li>
				<li>కేటగరీలు: రాజకీయం, ఆర్థికం, స్పోర్ట్స్ మొదలైనవి</li>
			</ul>
			<!-- Placeholder for affiliate ads -->
			<div class="affiliate-ad">
				<p>అఫిలియేట్ ప్రకటన: <a href="https://www.amazon.in">Amazon.in</a> లో శాపింగ్ చేయండి.</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
